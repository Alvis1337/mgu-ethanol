  "config": {
    "comment": "Ethanol content from the engine unit (DME, ecu 18 = 0x12), reads only. candidates are tried in order and the first plausible one wins (Settings > Ethanol source can pin one): did 550D = the BMW DME's PROZENT_ALK_KRST (alcohol in fuel, DME8FF_R), obd 52 = standard OBD PID 0x52 (ethanol fuel %) with OBD service 01, did F452 = the same PID through UDS 22 (no reply on the first car tried, and an unanswered request keeps the head unit's transport busy for seconds, so it goes last). value = raw * factor + offset (raw 0..255 = 0..100 %). probe: identifiers that are only READ and shown on the details line and the Debug page (raw bytes), never used as the value - add a DID here to work out its scaling on the car. Add your own candidates here if the DME answers another BMW-specific DID.",
    "ecu": 18,
    "candidates": [
      {"did": "550D", "bytes": 1, "at": 0, "factor": 0.39215686, "offset": 0, "min": 0, "max": 100},
      {"obd": "52", "bytes": 1, "at": 0, "factor": 0.39215686, "offset": 0, "min": 0, "max": 100},
      {"did": "F452", "bytes": 1, "at": 0, "factor": 0.39215686, "offset": 0, "min": 0, "max": 100}
    ],
    "probe": []
  }
}
