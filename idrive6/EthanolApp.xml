<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
     Ethanol screen for NBT Evo. Placement and structure follow MGD4096/IDRIVE_GAUGE_APP's GaugeApp.xml, which
     follows NBT-AAD (both PolyForm-Noncommercial; see idrive6/LICENSE): a row in the Media/Radio list
     (native state 20), after the Bluetooth audio row (focus 2270). entryButtonFocusID (32753) and
     applicationWeight (220) differ from the gauge app (32751 / 210) and NBT-AAD (32752 / 200) so all can be
     installed side by side. hmiState 10 holds seven labels, each bound to a raDataModel (ids 21..27);
     libEthanolApp.so writes the text into those models with PluginApp::updateModel. Property id 2 = SELECTABLE. -->
<pluginApps>
  <pluginApp applicationType="Custom" applicationWeight="220" entryButtonFocusID="32753" insertAfterFocusID="2270" insertStateID="20" text="ETHANOL APP">
    <comment/>
    <entryButton action="5" id="1" model="3" imageModel="4">
      <properties/>
    </entryButton>
    <actions>
      <hmiAction id="5" target="10"/>
    </actions>
    <models>
      <textIdModel id="3" textId="1">
        <synonyms/>
      </textIdModel>
      <imageIdModel id="4" imageId="56001"/>
      <raDataModel id="21"/>
      <raDataModel id="22"/>
      <raDataModel id="23"/>
      <raDataModel id="24"/>
      <raDataModel id="25"/>
      <raDataModel id="26"/>
      <raDataModel id="27"/>
    </models>
    <hmiStates>
      <hmiState id="10" text="ETHANOL APP" textModel="3">
        <components>
          <label id="31" model="21"><properties><property id="2" value="false"/></properties></label>
          <label id="32" model="22"><properties><property id="2" value="false"/></properties></label>
          <label id="33" model="23"><properties><property id="2" value="false"/></properties></label>
          <label id="34" model="24"><properties><property id="2" value="false"/></properties></label>
          <label id="35" model="25"><properties><property id="2" value="false"/></properties></label>
          <label id="36" model="26"><properties><property id="2" value="false"/></properties></label>
          <label id="37" model="27"><properties><property id="2" value="false"/></properties></label>
        </components>
      </hmiState>
    </hmiStates>
  </pluginApp>
</pluginApps>
